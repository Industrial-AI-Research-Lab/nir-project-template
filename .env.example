# Copy to .env and fill in. .env is ignored; every key here has a placeholder and one comment line.

# MLflow: a local database by default. Ask the supervisor whether the lab has a shared server;
# then put https://<server> here and fill in the S3 keys below.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=nir-project

# Shared tracking server only: the S3-compatible artifact store (for example MinIO).
MLFLOW_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# One seed for random, NumPy and the framework; logged as a run parameter.
SEED=42

# Where the raw data lives on this machine (ignored by Git).
DATA_DIR=data
